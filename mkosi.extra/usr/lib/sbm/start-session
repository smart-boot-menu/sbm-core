#!/bin/sh
# Graphical session for the sbm user. labwc stays up if the shell exits.
set -eu
export HOME=/var/lib/sbm
export USER=sbm
export LOGNAME=sbm
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/1000}"
export XDG_SESSION_TYPE=wayland
mkdir -p "$XDG_RUNTIME_DIR" /var/lib/sbm
chmod 700 "$XDG_RUNTIME_DIR" || true
# Allow wlroots software fallback when a GPU has no 3D acceleration (e.g.
# virtio-gpu without virgl or simpledrm). Explicit software mode forces it.
export WLR_RENDERER_ALLOW_SOFTWARE=1

software=0
reason="auto"
if grep -q 'sbm.renderer=software' /proc/cmdline 2>/dev/null; then
    software=1
    reason="cmdline"
fi
for state in /run/sbm/boot-efi/EFI/sbm/state/renderer /efi/EFI/sbm/state/renderer; do
    if [ -f "$state" ] && grep -q software "$state" 2>/dev/null; then
        software=1
        reason="esp-state"
    fi
done

if [ "$software" -eq 1 ]; then
    export WLR_RENDERER=pixman
    export ICED_BACKEND=tiny-skia
    export LIBGL_ALWAYS_SOFTWARE=1
    export GALLIUM_DRIVER=llvmpipe
    printf 'software (%s: pixman + tiny-skia)\n' "$reason" > "$XDG_RUNTIME_DIR/sbm-renderer"
elif [ ! -e /dev/dri/renderD128 ]; then
    export WLR_RENDERER=pixman
    export ICED_BACKEND=tiny-skia
    export LIBGL_ALWAYS_SOFTWARE=1
    export GALLIUM_DRIVER=llvmpipe
    printf 'software (no DRM render node: pixman + tiny-skia)\n' > "$XDG_RUNTIME_DIR/sbm-renderer"
else
    printf 'auto (DRM render node present)\n' > "$XDG_RUNTIME_DIR/sbm-renderer"
fi

set +e
/usr/bin/labwc
status=$?
echo "sbm-session: labwc exited with status=${status}" >&2
exit "$status"
