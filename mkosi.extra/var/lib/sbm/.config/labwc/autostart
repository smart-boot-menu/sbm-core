#!/bin/sh
# Allow the root-owned GParted process to use this user's XWayland display.
# sbm-cored also refreshes xhost right before spawning GParted because labwc
# runs Xwayland lazily (-terminate 10).
i=0
while [ "$i" -lt 25 ]; do
    if xhost +si:localuser:root >/dev/null 2>&1; then
        break
    fi
    i=$((i + 1))
    sleep 0.2
done
while true; do
    if sbm-ui 2>>/run/user/1000/sbm-ui.log; then
        status=0
    else
        status=$?
    fi
    if [ "$status" -ne 0 ] && [ "${ICED_BACKEND:-}" != "tiny-skia" ]; then
        echo "sbm-ui exited with status=${status}; falling back to ICED_BACKEND=tiny-skia" >>/run/user/1000/sbm-ui.log
        export ICED_BACKEND=tiny-skia
        printf 'software (wgpu fallback: tiny-skia)\n' > "${XDG_RUNTIME_DIR:-/run/user/1000}/sbm-renderer"
    fi
    sleep 1
done
