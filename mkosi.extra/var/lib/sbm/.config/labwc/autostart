#!/bin/sh
# Allow the root-owned GParted process to use this user's XWayland display.
# sbm-cored also refreshes xhost right before spawning GParted because labwc
# runs Xwayland lazily (-terminate 10).
i=0
while [ "$i" -lt 25 ]; do
    if xhost +si:localuser:root >/dev/null 2>&1; then
        break
    fi
    i=$((i + 1))
    sleep 0.2
done
while true; do
    sbm-ui 2>>/run/user/1000/sbm-ui.log || true
    sleep 1
done
