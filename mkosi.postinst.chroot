#!/bin/sh
set -eu
mkdir -p /usr/share/sbm
if command -v rpm >/dev/null 2>&1; then
    rpm -qa --qf '%{NAME}\t%{EPOCH}:%{VERSION}-%{RELEASE}\t%{ARCH}\t%{LICENSE}\n' \
        | sort >/usr/share/sbm/package-licenses.tsv
fi
if command -v fc-cache >/dev/null 2>&1; then
    fc-cache -f || true
fi
chmod 755 /usr/lib/sbm/start-session \
    /var/lib/sbm/.config/labwc/autostart 2>/dev/null || true
ln -sfn /usr/lib/systemd/system/multi-user.target /etc/systemd/system/default.target
if [ -n "${OUTPUTDIR:-}" ] && [ -d "$OUTPUTDIR" ]; then
    cp /usr/share/sbm/package-licenses.tsv "$OUTPUTDIR/package-licenses-${ARCHITECTURE:-unknown}.tsv" || true
fi
